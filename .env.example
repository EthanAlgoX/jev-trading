# 与原 jev-trader 相同的 Jev 配置。Bun 自动加载 .env。
# 也可在网页「连接设置」填写，无需编辑本文件。
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
PORT=3000
# 设为 0 可关闭 macOS 交互终端自动打开浏览器。
OPEN_BROWSER=1

# 通常自动识别；仅在识别失败时取消注释并填写实际路径。
# AISTOCK_PATH=/path/to/AI-Stock
# AISTOCK_PYTHON=/path/to/AI-Stock/.venv/bin/python

# 推理后端：jev（云端，默认）/ local（本地决策引擎）
JEV_BACKEND=jev
# 本地概率计算方式：logprobs（默认）/ generated
JEV_LOCAL_ENGINE=logprobs
# 本地服务的 Jev 兼容 API 根地址，不是底层聊天模型端口。
# generated 默认 8080；logprobs 默认 8000。
# JEV_LOCAL_BASE_URL=http://127.0.0.1:8080
JEV_LOCAL_MODEL=jev-latest
JEV_LOCAL_API_KEY=
# 可选审计标签，不会自动下载或切换上游权重
JEV_LOCAL_MODEL_ID=
JEV_LOCAL_MODEL_REVISION=
# 1–300 秒；未设置时云端 30、本地 180
# JEV_MODEL_TIMEOUT_SECONDS=30

# 按请求 localEngine 选择时，可独立配置两种本地计算方式；已保存的对应网页配置优先。
# JEV_LOCAL_GENERATED_BASE_URL=http://127.0.0.1:8080
# JEV_LOCAL_GENERATED_API_KEY=
# JEV_LOCAL_GENERATED_MODEL=jev-latest
# JEV_LOCAL_GENERATED_TIMEOUT_SECONDS=180
# JEV_LOCAL_LOGPROBS_BASE_URL=http://127.0.0.1:8000
# JEV_LOCAL_LOGPROBS_API_KEY=
# JEV_LOCAL_LOGPROBS_MODEL=jev-latest
# JEV_LOCAL_LOGPROBS_TIMEOUT_SECONDS=180
