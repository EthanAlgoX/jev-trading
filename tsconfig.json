  "compilerOptions": {
    "target": "ESNext", "module": "Preserve", "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "types": ["bun"], "strict": true,
    "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true
